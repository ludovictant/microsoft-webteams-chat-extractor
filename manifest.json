{
	"manifest_version": 3,

	"name": "Microsoft Teams Chat Extractor",
	"description": "Pulls out the chat transcript from the Microsoft Teams online interface",
	"version": "3.9.0",
	"author": "Ludovic Tant from Ingo Muschenetz's code",

	"permissions": [
		"activeTab",
		"scripting",
		"downloads",
		"storage",
		"alarms"
	],

	"host_permissions": [
		"https://raw.githubusercontent.com/*"
	],

	"background": {
		"service_worker": "background.js"
	},

	"web_accessible_resources": [
		{
			"resources": ["lib/jszip.min.js"],
			"matches": ["https://teams.microsoft.com/*"]
		}
	],

	"action": {
		"default_icon": "icons/chat-32.png",
		"default_popup": "popup.html"
	},

	"icons": {
		 "32": "icons/chat-32.png",
		 "48": "icons/chat-48.png",
		 "128": "icons/chat-128.png"
	}
}
